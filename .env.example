# Optional. Without these the app still works: template script + browser voice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite  # measured 0.7 s; 3.8-flash took 19-82 s on 2026-10-09
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George": works on the free plan (library voices like Rachel need a paid plan for API use)
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=     # set by `npm run agent:setup` (needs a key with ElevenAgents: Write); empty = command-based voice mode

SENSOR_TOKEN=          # must match the ESP32 sketch / sim; empty = sensor readings rejected
