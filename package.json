{
  "name": "hackru-26",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.mjs\" \"vite --config web/vite.config.ts\"",
    "server": "node server/index.mjs",
    "typecheck": "tsc -p web",
    "build": "tsc -p web && vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test test/",
    "sensor:sim": "node hardware/sim_sensor.mjs",
    "cameras:check": "node scripts/check_cameras.mjs",
    "tts:time": "node scripts/time_tts.mjs",
    "demo:links": "node scripts/demo_links.mjs",
    "demo:clean": "node scripts/clean_test_data.mjs",
    "a11y:contrast": "node scripts/a11y_contrast.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
